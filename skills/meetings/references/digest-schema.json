{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meetings/digest",
  "title": "Meeting digest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "date",
    "source",
    "attendees",
    "summary",
    "decisions",
    "action_items",
    "follow_ups",
    "open_questions",
    "source_quality"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\n]*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "string",
      "enum": [
        "teams",
        "slack",
        "manual"
      ]
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\n]*$"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "firmness",
          "by"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n]*$"
          },
          "firmness": {
            "type": "string",
            "enum": [
              "committed",
              "leaning",
              "discussed"
            ]
          },
          "by": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "owner",
          "due",
          "jira",
          "ticket_worthy"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n]*$"
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "due": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "jira": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^DEV-\\d+$"
          },
          "ticket_worthy": {
            "type": "boolean"
          }
        }
      }
    },
    "follow_ups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "with",
          "when"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n]*$"
          },
          "with": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "when": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^\\n]*$"
      }
    },
    "source_quality": {
      "type": "string",
      "enum": [
        "verbatim",
        "captions",
        "notes"
      ]
    },
    "landed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "heading"
      ],
      "description": "Set by write_org.py after landing: where the block went.",
      "properties": {
        "file": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        }
      }
    }
  }
}
